<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
</head>
<body>

    <h2>Login</h2>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form action="/login" method="POST">

        <input
            type="text"
            name="username"
            placeholder="Username (admin)"
            required
        >
        <br><br>

        <input
            type="password"
            name="password"
            placeholder="Password (123)"
            required
        >
        <br><br>

        <button type="submit">Login</button>

    </form>

</body>
</html>
